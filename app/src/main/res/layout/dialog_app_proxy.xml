<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/proxyAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/proxyTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/proxyTypeNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proxy_none" />

            <RadioButton
                android:id="@+id/proxyTypeHttp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proxy_http" />

            <RadioButton
                android:id="@+id/proxyTypeSocks5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proxy_socks5" />
        </RadioGroup>

        <EditText
            android:id="@+id/proxyHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/proxy_host"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/proxyPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/proxy_port"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="5"
            android:maxLines="1" />

        <EditText
            android:id="@+id/proxyUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/proxy_username"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/proxyPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/proxy_password"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/proxyBypass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/proxy_bypass"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/proxy_scope_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
