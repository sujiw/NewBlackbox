<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar_layout"
        layout="@layout/view_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/appName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Device ID" />

            <TextView
                android:id="@+id/appPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textSize="12sp"
                tools:text="com.appsflyer.android.deviceid" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_proxy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/proxyEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/proxyTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/proxyTypeNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proxy_none" />

                <RadioButton
                    android:id="@+id/proxyTypeHttp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proxy_http" />

                <RadioButton
                    android:id="@+id/proxyTypeSocks5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proxy_socks5" />
            </RadioGroup>

            <EditText
                android:id="@+id/proxyHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_host"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />

            <EditText
                android:id="@+id/proxyPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_port"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1" />

            <EditText
                android:id="@+id/proxyUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_username"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/proxyPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1" />

            <EditText
                android:id="@+id/proxyBypass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_bypass"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/config_gaid"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/gaidValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/gaid_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <CheckBox
                android:id="@+id/gaidLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_gaid_limit" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/config_device"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/deviceBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_brand"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/deviceModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_model"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/deviceManufacturer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_manufacturer"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/deviceDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_device_name"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/deviceProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_product"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/deviceWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/config_width"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/deviceHeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/config_height"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/deviceDpi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/config_dpi"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/config_restart_hint"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_save" />

                <Button
                    android:id="@+id/clearButton"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_clear" />

                <Button
                    android:id="@+id/launchButton"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_start_app" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
